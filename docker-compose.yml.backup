version: "3.9"

services:
  emqx:
    image: emqx/emqx:5.1.0
    container_name: emqx
    restart: unless-stopped
    ports:
      - "1883:1883"      # MQTT
      - "8083:8083"      # WebSocket MQTT
      - "18083:18083"    # Dashboard
    environment:
      EMQX_ALLOW_ANONYMOUS: "true"            # Allow anonymous MQTT connections
      EMQX_DASHBOARD__DEFAULT_USERNAME: admin  # Optional dashboard login
      EMQX_DASHBOARD__DEFAULT_PASSWORD: admin  # Optional dashboard login
      EMQX_NODE__NAME: emqx@emqx
      EMQX_NODE__COOKIE: mysecretcookie

  influxdb:
    image: influxdb:1.8
    container_name: influxdb
    ports:
      - "8087:8086"
    environment:
      INFLUXDB_DB: mqtt_data
      INFLUXDB_ADMIN_USER: admin
      INFLUXDB_ADMIN_PASSWORD: secret123
      INFLUXDB_HTTP_AUTH_ENABLED: "true"

  mongo:
    image: mongo:7
    container_name: mongo
    ports:
      - "27017:27017"
    environment:
      MONGO_INITDB_ROOT_USERNAME: admin
      MONGO_INITDB_ROOT_PASSWORD: secret123

  fastapi:
    build: .
    container_name: fastapi_app
    ports:
      - "8000:8000"
    environment:
      # MQTT Broker (no credentials needed)
      MQTT_BROKER: emqx
      MQTT_PORT: 1883

      # InfluxDB
      INFLUXDB_URL: http://influxdb:8086
      INFLUXDB_USERNAME: admin
      INFLUXDB_PASSWORD: secret123
      INFLUXDB_DB: mqtt_data

      # MongoDB
      MONGO_DB: mqtt_data
      MONGO_URI: mongodb://admin:secret123@mongo:27017/?authSource=admin
    depends_on:
      - emqx
      - influxdb
      - mongo
    volumes:
      - ./fastapi_logs:/app/logs
   grafana:
    image: grafana/grafana:latest
    container_name: grafana
    ports:
      - "3000:3000"
    volumes:
      - grafana_data:/var/lib/grafana
    environment:
      GF_SECURITY_ADMIN_USER: admin           # Grafana username
      GF_SECURITY_ADMIN_PASSWORD: admin       # Grafana password
    restart: unless-stopped
    depends_on:
      - loki

  loki:
    image: grafana/loki:latest
    container_name: loki
    ports:
      - "3100:3100"
    volumes:
      # Mount your Loki config file inside a subfolder to avoid file/directory conflicts
      - ./loki-config.yaml:/etc/loki/config/loki-config.yaml
      - loki_data:/loki
    command: -config.file=/etc/loki/config/loki-config.yaml
    restart: unless-stopped

  promtail:
    image: grafana/promtail:latest
    container_name: promtail
    volumes:
      - ./promtail-config.yaml:/mnt/config/promtail-config.yaml
      - /var/log:/var/log                   # Mount host logs
    command: -config.file=/mnt/config/promtail-config.yaml
    depends_on:
      - loki
    restart: unless-stopped

volumes:
  loki_data:
  grafana_data:
